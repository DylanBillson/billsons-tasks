########################################
# Application
########################################

APP_NAME="Billson's Tasks"
APP_ENV=development
APP_DEBUG=true

BASE_URL=https://tasks.billson.xyz
DEFAULT_TIMEZONE=Europe/London

APP_SECRET_KEY=change-this-to-a-long-random-secret

########################################
# Database
########################################

POSTGRES_DB=billsons_tasks
POSTGRES_USER=billsons_tasks
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql+psycopg://billsons_tasks:change-this-password@db:5432/billsons_tasks

########################################
# Sessions
########################################

SESSION_COOKIE_NAME=billsons_tasks_session
SESSION_MAX_AGE_HOURS=12
SESSION_REMEMBER_ME_DAYS=30
SESSION_LAST_SEEN_UPDATE_MINUTES=5
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

########################################
# Security
########################################

PASSWORD_MIN_LENGTH=12

########################################
# Notifications
########################################

NOTIFICATIONS_ENABLED=true

########################################
# Logging
########################################

LOG_LEVEL=INFO

########################################
# Reverse Proxy
########################################

TRAEFIK_HOST=tasks.billson.xyz

########################################
# Email
########################################

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=username
SMTP_PASSWORD=change-this-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Billson's Tasks"
SMTP_USE_TLS=true

########################################
# Feedback
########################################

FEEDBACK_EMAIL_TO=no-reply@example.com

########################################
# Live Updates
########################################

LIVE_UPDATES_ENABLED=true
LIVE_UPDATES_POLL_INTERVAL_SECONDS=5